SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-web-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-client-secret
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=PocketCrew <invites@your-verified-domain.example>
POCKETCREW_APP_URL=pocketcrew://invite
# Active shopping provider. Store the real key in Supabase Edge Function Secrets,
# never in either native app's CloudConfig.plist or in source control.
SERPAPI_API_KEY=replace-with-serpapi-api-key
# The historical spelling SERPAI_API_KEY is accepted if already configured.

# Optional legacy Amazon adapter; the current app does not call this endpoint.
# These values are NOT required for Google Shopping via SerpApi.
AMAZON_CREATORS_CREDENTIAL_ID=replace-with-creators-api-credential-id
AMAZON_CREATORS_CREDENTIAL_SECRET=replace-with-creators-api-credential-secret
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_ASSOCIATE_PARTNER_TAG=replace-with-associate-tag
AMAZON_MARKETPLACE=www.amazon.com
